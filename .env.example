# Copy to .env. Everything here has a working default except the secrets.

ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cadence

# Generate with: openssl rand -hex 32
# The app refuses to start in production if this is left at the default.
JWT_SECRET=local-dev-secret-not-for-production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Optional. Without it, a scripted interviewer runs instead -- the whole app
# works, the questions are just fixed.
ANTHROPIC_API_KEY=

# Hard ceiling per session, enforced before each call rather than after.
SESSION_COST_CEILING_USD=0.50

CORS_ORIGINS=http://localhost:3000
